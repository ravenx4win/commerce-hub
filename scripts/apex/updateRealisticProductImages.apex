rop&q=60#CH-TRV009@https://images.unsplash.com/photo-1585338107529-13afc5f02586?w=500&auto=format&fit=crop&q=60#CH-TRV010@https://images.unsplash.com/photo-1541781774459-bb2af2f05b55?w=500&auto=format&fit=crop&q=60#CH-TRV011@https://images.unsplash.com/photo-1528740561666-dc2479dc08ab?w=500&auto=format&fit=crop&q=60#CH-TRV012@https://images.unsplash.com/photo-1548036328-c9fa89d128fa?w=500&auto=format&fit=crop&q=60#CH-TRV013@https://images.unsplash.com/photo-1622560480605-d83c853bc5c3?w=500&auto=format&fit=crop&q=60#CH-TRV014@https://images.unsplash.com/photo-1590874103328-eac38a683ce7?w=500&auto=format&fit=crop&q=60#CH-TRV015@https://images.unsplash.com/photo-1575032617751-6ddec2089882?w=500&auto=format&fit=crop&q=60#CH-WAT001@https://images.unsplash.com/photo-1524592094714-0f0654e20314?w=500&auto=format&fit=crop&q=60#CH-WAT002@https://images.unsplash.com/photo-1510017803434-a899398421b3?w=500&auto=format&fit=crop&q=60#CH-WAT003@https://images.unsplash.com/photo-1522335789203-aabd1fc54bc9?w=500&auto=format&fit=crop&q=60#CH-WAT004@https://images.unsplash.com/photo-1533139502658-0198f920d8e8?w=500&auto=format&fit=crop&q=60#CH-WAT005@https://images.unsplash.com/photo-1524805444758-089113d48a6d?w=500&auto=format&fit=crop&q=60#CH-WAT006@https://images.unsplash.com/photo-1619134778706-7015533a6150?w=500&auto=format&fit=crop&q=60#CH-WAT007@https://images.unsplash.com/photo-1509042239860-f550ce710b93?w=500&auto=format&fit=crop&q=60#CH-WAT008@https://images.unsplash.com/photo-1579586337278-3befd40fd17a?w=500&auto=format&fit=crop&q=60#CH-WAT009@https://images.unsplash.com/photo-1614164185128-e4ec99c436d7?w=500&auto=format&fit=crop&q=60#CH-WAT010@https://images.unsplash.com/photo-1606760227091-3dd870d97f1d?w=500&auto=format&fit=crop&q=60#CH-WAT011@https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=500&auto=format&fit=crop&q=60#CH-WAT012@https://images.unsplash.com/photo-1539185441755-769473a23570?w=500&auto=format&fit=crop&q=60#CH-WAT013@https://images.unsplash.com/photo-1509941943102-10c232535736?w=500&auto=format&fit=crop&q=60#CH-WAT014@https://images.unsplash.com/photo-1526045612212-70caf35c14df?w=500&auto=format&fit=crop&q=60#CH-WAT015@https://images.unsplash.com/photo-1518131672697-613becd4fab5?w=500&auto=format&fit=crop&q=60';

String[] allPairs = (c1 + '#' + c2 + '#' + c3 + '#' + c4).split('#');

Map<String, String> imgMap = new Map<String, String>();
for(String p : allPairs) {
    if(String.isNotBlank(p)) {
        String[] parts = p.split('@');
        if(parts.size() == 2) {
            imgMap.put(parts[0], parts[1]);
        }
    }
}

Map<Id, Product2> prodMap = new Map<Id, Product2>([SELECT Id, ProductCode FROM Product2 WHERE ProductCode != null]);
Map<String, Id> codeToId = new Map<String, Id>();
for(Product2 p : prodMap.values()) {
    codeToId.put(p.ProductCode, p.Id);
}

List<ProductImage__c> existingImgs = [SELECT Id, Product__c, Product__r.ProductCode, Image_URL__c FROM ProductImage__c WHERE Product__c IN :prodMap.keySet()];
List<ProductImage__c> toUpsert = new List<ProductImage__c>();
Set<Id> updatedProductIds = new Set<Id>();

for(ProductImage__c img : existingImgs) {
    String code = img.Product__r.ProductCode;
    if(imgMap.containsKey(code)) {
        img.Image_URL__c = imgMap.get(code);
        img.Active__c = true;
        toUpsert.add(img);
        updatedProductIds.add(img.Product__c);
    }
}

for(String code : imgMap.keySet()) {
    if(codeToId.containsKey(code) && !updatedProductIds.contains(codeToId.get(code))) {
        toUpsert.add(new ProductImage__c(
            Product__c = codeToId.get(code),
            Image_URL__c = imgMap.get(code),
            Alt_Text__c = 'Front',
            Display_Order__c = 1,
            Active__c = true
        ));
    }
}

if(!toUpsert.isEmpty()) {
    upsert toUpsert;
    System.debug('Successfully updated ' + toUpsert.size() + ' product images with realistic verified imagery.');
}
